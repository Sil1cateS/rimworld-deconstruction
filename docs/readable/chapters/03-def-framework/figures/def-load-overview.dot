digraph DefLoadOverview {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.38", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="普通启动：文件怎样成为可查询、可引用的定义"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.14", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  content [label="活动内容包与加载目录\n程序集提供可查找的 C# 类型"];
  xml [label="读取 XML → LoadableXmlAsset\n保存文档与来源"];
  patch [label="CombineIntoUnifiedXML → ApplyPatches\n先组合文档，再修改当前 XML"];
  inherit [label="ParseAndProcessXML\n登记模板，准备继承合并结果"];
  parse [label="默认读取器建立 Def 与配置\n调用相应 PostLoad，登记待连接引用"];
  store [label="按来源登记 → 各类型数据库入库\n此时已经可以按名称取得已入库项", fillcolor="#e8f4ed", color="#a5cbb8"];
  binding [label="多轮名称引用解析与 PreResolve 生成\n穿插早期、最终 DefOf 绑定", fillcolor="#fff3d8", color="#cfb579"];
  resolve [label="前置系统准备\n各类型 ResolveReferences"];
  post [label="PostResolve 生成\n后置系统准备"];
  hash [label="开发者模式的整批检查分支 → 键位初始化\n分配 shortHash，建立对应查询字典"];
  use [label="后续代码查询或读取已有引用\n具体功能由使用者继续处理", fillcolor="#f0eafa", color="#b5a1d1"];
  content -> xml -> patch -> inherit -> parse -> store -> binding -> resolve -> post -> hash -> use;
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="概括普通启动的定义主线；省略语言、资源与其他全局初始化的部分调用。\n查询在加载途中也会发生，不是直到图的末尾才首次可用。\nExecuteWhenFinished 中安排的函数，不因登记而统一视为已经完成。"];
  use -> legend [style=invis];
}
