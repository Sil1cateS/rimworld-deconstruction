digraph DefBindingStages {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.4", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="名称解析、代码生成与 DefOf 绑定的相对顺序"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  db [label="XML 定义已经建立并入库\n名称引用记录仍有待处理项"];
  first [label="① 名称引用解析：Silent", fillcolor="#e8f4ed", color="#a5cbb8"];
  early [label="早期 DefOf 绑定：true\n以及相关语言等早期处理"];
  gen1 [label="PreResolve 生成器：前一部分\n生成对象并加入相应类型数据库"];
  second [label="② 生成器内部名称引用解析：Silent", fillcolor="#e8f4ed", color="#a5cbb8"];
  gen2 [label="PreResolve 生成器：其余部分\n继续生成并入库，然后返回"];
  third [label="③ 名称引用解析：LogErrors\nfinally 中 Clear 待连接记录", fillcolor="#fff3d8", color="#cfb579"];
  final [label="最终 DefOf 绑定：false"];
  resolve [label="前置准备 → 各类型 ResolveReferences"];
  later [label="PostResolve 生成 → 后置准备\n检查分支、键位与短哈希等后续阶段", fillcolor="#f0eafa", color="#b5a1d1"];
  db -> first -> early -> gen1 -> second -> gen2 -> third -> final -> resolve -> later;
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="图示普通启动，省略部分全局初始化和具体生成器。\nClear 清除登记记录，不撤销已经写入的字段与集合。\n类型自身的 ResolveReferences 与按名称解析是两个不同入口。"];
  later -> legend [style=invis];
}
