digraph DefStorageViews {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.6", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="来源与类型：多个容器保存同一份定义引用"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  pack [label="ModContentPack.defs\n按来源组织定义"];
  subgraph cluster_database {
    label="DefDatabase<T>：按类型组织"; fontname="Microsoft YaHei"; fontsize=16; fontcolor="#415b73"; color="#a5cbb8"; style="rounded"; margin=18;
    list [label="defsList\n列表位置与遍历"];
    name [label="defsByName\n以 defName 为键"];
    hash [label="defsByShortHash\n以 shortHash 为键", fillcolor="#fff3d8", color="#cfb579"];
    {rank=same; list; name; hash;}
  }
  def [label="同一个 Def 对象\n运行时类型可作为 T 使用", fillcolor="#f0eafa", color="#b5a1d1"];
  pack -> def [label="已有来源登记时保存引用"];
  list -> def [label="列表项"];
  name -> def [label="字典值"];
  hash -> def [style=dashed, label="后续阶段填写"];
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="箭头表示保存的对象引用，不是执行顺序，也没有复制四份定义。\n图省略其他条目、patchedDefs 以及兼容父类型的其他数据库。\n没有对应来源的对象另行登记，不保证每个 Def 都来自一个内容包。"];
  def -> legend [style=invis];
}
