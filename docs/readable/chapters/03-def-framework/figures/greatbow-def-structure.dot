digraph GreatbowDefStructure {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.65", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="Bow_Great：定义对象中的部分配置与引用"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  bow [label="一个 Verse.ThingDef 对象\ndefName = Bow_Great\nlabel = greatbow\nthingClass 指向 ThingWithComps 的 Type", fillcolor="#f0eafa", color="#b5a1d1"];
  stats [label="statBases 列表中的一项\nStatModifier\nvalue = 3"];
  cost [label="costList 列表中的一项\nThingDefCountClass\ncount = 60"];
  recipe [label="recipeMaker\nRecipeMakerProperties", fillcolor="#e8f4ed", color="#a5cbb8"];
  comps [label="comps：4 个配置对象\ncompClass 指定各实际组件类型\n此处没有建立实际 ThingComp"];
  mass [label="StatDef\ndefName = Mass", fillcolor="#fff3d8", color="#cfb579"];
  wood [label="ThingDef\ndefName = WoodLog", fillcolor="#fff3d8", color="#cfb579"];
  research [label="ResearchProjectDef\ndefName = Greatbow", fillcolor="#fff3d8", color="#cfb579"];
  bow -> stats [label="statBases"];
  bow -> cost [label="costList"];
  bow -> recipe [label="recipeMaker"];
  bow -> comps [label="comps"];
  stats -> mass [label="stat"];
  cost -> wood [label="thingDef"];
  recipe -> research [label="researchPrerequisite"];
  {rank=same; stats; cost; recipe; comps;}
  {rank=same; mass; wood; research;}
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="按原始 Core XML 与模板链推导，假定名称引用正常连接；仅画部分字段。\n箭头表示对象引用，不表示继承、物品创建或执行顺序。\nBow_Great 是武器定义，Greatbow 是另一份研究项目定义。"];
  {rank=sink; legend;}
  mass -> legend [style=invis];
  wood -> legend [style=invis];
  research -> legend [style=invis];
}
