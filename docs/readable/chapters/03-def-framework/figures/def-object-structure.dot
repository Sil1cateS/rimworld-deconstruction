digraph DefObjectStructure {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.6", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="一份定义内部：值、配置对象与已有定义的引用"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  def [label="一个 Def 派生对象\n共同字段 + 具体类型新增字段", fillcolor="#f0eafa", color="#b5a1d1"];
  values [label="本对象的值与类型信息\n字符串、数值、枚举、Type 等"];
  config [label="普通嵌套配置对象\n有自己的字段与方法", fillcolor="#e8f4ed", color="#a5cbb8"];
  collection [label="列表或字典对象\n组织值、配置或定义引用"];
  other [label="另一份已经建立的 Def\n也可被多个对象共同引用", fillcolor="#fff3d8", color="#cfb579"];
  def -> values [label="保存字段"];
  def -> config [label="保存配置引用"];
  def -> collection [label="保存集合引用"];
  def -> other [label="直接 Def 引用"];
  config -> other [label="配置中也可持有"];
  collection -> other [label="集合项可以引用"];
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="箭头表示字段、持有与引用关系，不表示继承或加载顺序。\n具体对象有哪些字段，由其 C# 类型决定；图不要求每份定义都有全部类别。"];
  other -> legend [style=invis];
  values -> legend [style=invis];
}
