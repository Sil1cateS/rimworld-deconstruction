digraph StepAndWorld {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.45", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="一轮主线程更新怎样进入对象与组件管理"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.18,0.14", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  host [label="RunLoop 进入更新分支\n调用 Bootstrap 登记的 OnUpdate", fillcolor="#f0eafa", color="#b5a1d1"];
  step [label="UnityRuntime.Step", fillcolor="#f0eafa", color="#b5a1d1"];
    prepare [label="Time.BeginFrame\n保存本轮时间、增加兼容层帧号\nSceneManager.ProcessPendingLoad"];
    update [label="World.Update\n销毁、激活、首次 Start → Updating\n→ 活动 Behaviour.Update → PostUpdate"];
    late [label="World.LateUpdate\nLateUpdating → 活动 Behaviour.LateUpdate\n→ 销毁处理 → PostLateUpdate"];
    camera [label="Camera.DispatchPreCullForScreenCameras\n屏幕相机阶段通知", fillcolor="#f2f5f8", color="#aab8c8"];
    prepare -> update -> late -> camera;
  records [label="同一个 UnityWorld 的管理数据\n_objects：实际对象与记录的对应\n_behaviours：相应组件的记录\n待激活、待 Start、待销毁列表", fillcolor="#e8f4ed", color="#a5cbb8"];
  after [label="返回 OnUpdate 与 RunLoop\n继续本轮后续工作及绘制数据采集", fillcolor="#f0eafa", color="#b5a1d1"];
  host -> step -> prepare;
  camera -> after;
  {rank=same; update; records;}
  update -> records [style=dashed, color="#3a8b74", label="查询、更新记录", constraint=false];
  late -> records [style=dashed, color="#3a8b74", constraint=false];
}
