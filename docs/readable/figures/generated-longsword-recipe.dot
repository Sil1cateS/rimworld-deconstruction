digraph GeneratedLongSwordRecipe {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.45", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="从长剑的 recipeMaker，到工作台取得制造配方"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  sword [label="已读取的长剑 ThingDef\ndefName = MeleeWeapon_LongSword\nrecipeMaker 保存研究、技能、场所等配置"];
  create [label="RecipeDefGenerator\n筛选 recipeMaker 非 null 的物品定义\nCreateRecipeDefFromMaker"];
  recipe [label="新 RecipeDef\ndefName = Make_MeleeWeapon_LongSword\nproducts 引用长剑定义，recipeUsers 引用制造场所", fillcolor="#e8f4ed", color="#a5cbb8"];
  register [label="AddImpliedDef<RecipeDef>\n标记来源、PostLoad、加入配方数据库"];
  workbench [label="工作台 ThingDef 的 AllRecipes 首次建立缓存\n扫描 RecipeDef 数据库\nrecipeUsers 包含自己时，将配方加入候选集合"];
  entry [label="制造系统取得该配方的入口\n研究、技能、材料与实际执行继续由相应系统判断", fillcolor="#f0eafa", color="#b5a1d1"];
  sword -> create -> recipe -> register;
  register -> workbench [label="后续首次查询"];
  workbench -> entry;
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="箭头表示本例的数据建立与取得路径，省略具体生成代码的其他步骤。\n生成配方不会立即生成实际长剑；产物条目保存的仍是定义与数量。\n本图不展开热重载、实际任务执行与界面筛选。"];
  entry -> legend [style=invis];
}
