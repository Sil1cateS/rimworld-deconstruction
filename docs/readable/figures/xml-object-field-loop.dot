// Render fixed positions with: neato -n2 -Tpng xml-object-field-loop.dot -o xml-object-field-loop.png
digraph XmlObjectFieldLoop {
  graph [layout=neato, overlap=true, splines=polyline, bgcolor="white", pad="0.22", fontname="Microsoft YaHei", fontsize=21, fontcolor="#17324d", labelloc=t, label="字段读取：每轮处理一个子节点"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.16,0.12", width=2.7, height=0.75, penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  start [pos="310,1080!", label="取得模板解析结果\n建立目标对象"];
  more [pos="310,960!", shape=diamond, style=filled, width=2.7, height=1.1, label="还有未处理的\n子节点？", fillcolor="#fff3d8", color="#cfb579"];
  field [pos="310,840!", label="取一个子节点\n普通元素按名称查字段"];
  skip [pos="310,720!", shape=diamond, style=filled, width=2.7, height=1.1, label="是注释，或\n未找到字段？", fillcolor="#fff3d8", color="#cfb579"];
  type [pos="310,600!", label="按字段类型与节点 Class\n确定读取类型"];
  isdef [pos="310,480!", shape=diamond, style=filled, width=2.7, height=1.1, label="是 Def 类型？", fillcolor="#fff3d8", color="#cfb579"];
  reference [pos="170,330!", width=3.0, label="非空文本：登记待连接名称\n空文本：将字段设为 null", fillcolor="#fff3d8", color="#cfb579"];
  value [pos="425,330!", width=3.0, height=1.0, label="调用字段读取方法\n解析值或建立嵌套配置、列表\n写入字段", fillcolor="#e8f4ed", color="#a5cbb8"];
  next [pos="310,180!", label="当前项处理结束\n子节点下标加 1"];
  post [pos="760,960!", width=3.1, label="全部节点遍历结束\n若有 PostLoad，就调用它", fillcolor="#f0eafa", color="#b5a1d1"];
  result [pos="760,840!", width=3.1, label="对象交回上层\n待连接名称留给后续步骤", fillcolor="#f0eafa", color="#b5a1d1"];
  node [shape=point, width=0.001, height=0.001, label="", style=invis];
  loop_top [pos="25,960!"];
  loop_bottom [pos="25,180!"];
  skip_top [pos="575,720!"];
  skip_bottom [pos="575,180!"];
  start:s -> more:n;
  more:s -> field:n [label="是"];
  more:e -> post:w [label="否：退出循环"];
  post:s -> result:n;
  field:s -> skip:n;
  skip:s -> type:n [label="否"];
  skip:e -> skip_top [label="是：跳过", arrowhead=none];
  skip_top -> skip_bottom [arrowhead=none];
  skip_bottom -> next:e;
  type:s -> isdef:n;
  isdef:sw -> reference:n [label="是"];
  isdef:se -> value:n [label="否"];
  reference:s -> next:nw;
  value:s -> next:ne;
  next:w -> loop_bottom [arrowhead=none];
  loop_bottom -> loop_top [arrowhead=none];
  loop_top -> more:w [label="继续"];
  legend [shape=plain, style="", pos="450,45!", fontsize=12, fontcolor="#526d85", label="左侧回线返回循环判断；只有全部节点处理后，才走右上方出口。\n图示为普通复杂对象路径，省略值类型装箱、异常等细节。\nPostLoad 执行时，其他 Def 的引用可能仍待连接。"];
}
