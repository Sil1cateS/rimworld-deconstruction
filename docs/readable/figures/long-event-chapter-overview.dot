digraph LongEventChapterOverview {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.32", ranksep="0.45", fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="长任务怎样执行和收尾"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=16, fontcolor="#17324d", margin="0.18,0.14", penwidth=1.2];
  edge [color="#526d85", arrowsize=0.8, penwidth=1.3];
  queue [label="QueueLongEvent\n保存任务并入队"];
  select [label="主线程的 Root.Update\n推进当前任务，空闲时取下一项"];
  choose [shape=diamond, style=filled, label="选中的任务\n采用哪种执行方式？", fillcolor="#fff3d8", color="#cfb579"];
  sync [label="同步任务\n主线程直接执行函数\n按需先等待提示绘制"];
  asyncTask [label="异步任务\n长任务线程执行函数\n主线程后续检查完成", fillcolor="#f0eafa", color="#b5a1d1"];
  iterator [label="迭代器任务\n主线程分段调用 MoveNext\n保留进度供后续更新"];
  finish [label="主线程收尾\n处理任务记录和后续函数\n队列还有任务时接续下一项", fillcolor="#e8f4ed", color="#a5cbb8"];
  queue -> select -> choose;
  {rank=same; sync; asyncTask; iterator;}
  choose -> sync;
  choose -> asyncTask;
  choose -> iterator;
  sync -> finish;
  asyncTask -> finish;
  iterator -> finish;
}
