digraph ComponentInheritance {
  graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.24", ranksep="0.35", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="从 UnityEngine.Object 逐层展开\n只列相关子树；箭头从基类指向派生类，不表示调用"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=14, fontcolor="#17324d", margin="0.15,0.11", penwidth=1.2];
  edge [color="#526d85", arrowsize=0.7, penwidth=1.2];
  systemobject [label="System.Object\nC# 的 object", fillcolor="#f2f5f8", color="#aab8c8"];
  object [label="UnityEngine.Object", fillcolor="#f2f5f8", color="#aab8c8"];
  material [label="Material", fillcolor="#f4f0e7", color="#cbbfa6"];
  mesh [label="Mesh", fillcolor="#f4f0e7", color="#cbbfa6"];
  texture [label="Texture", fillcolor="#f4f0e7", color="#cbbfa6"];
  texture2d [label="Texture2D", fillcolor="#f4f0e7", color="#cbbfa6"];
  scriptable [label="ScriptableObject", fillcolor="#f4f0e7", color="#cbbfa6"];
  go [label="GameObject", fillcolor="#f0eafa", color="#b5a1d1"];
  component [label="Component"];
  transform [label="Transform"];
  meshfilter [label="MeshFilter"];
  renderer [label="Renderer"];
  meshrenderer [label="MeshRenderer"];
  behaviour [label="Behaviour", fillcolor="#e8f4ed", color="#a5cbb8"];
  camera [label="Camera"];
  audiobehaviour [label="AudioBehaviour"];
  audiosource [label="AudioSource"];
  audiolistener [label="AudioListener"];
  mono [label="MonoBehaviour", fillcolor="#e8f4ed", color="#a5cbb8"];
  driver [label="CameraDriver", fillcolor="#fff3d6", color="#d2b66e"];
  root [label="Root", fillcolor="#fff3d6", color="#d2b66e"];
  entry [label="Root_Entry", fillcolor="#fff3d6", color="#d2b66e"];
  play [label="Root_Play", fillcolor="#fff3d6", color="#d2b66e"];
  systemobject -> object;
  object -> material;
  object -> mesh;
  object -> texture;
  texture -> texture2d;
  object -> scriptable;
  object -> go;
  object -> component;
  component -> transform;
  component -> meshfilter;
  component -> renderer;
  component -> behaviour;
  renderer -> meshrenderer;
  behaviour -> camera;
  behaviour -> audiobehaviour;
  behaviour -> mono;
  audiobehaviour -> audiosource;
  audiobehaviour -> audiolistener;
  mono -> driver;
  mono -> root;
  root -> entry;
  root -> play;
}
