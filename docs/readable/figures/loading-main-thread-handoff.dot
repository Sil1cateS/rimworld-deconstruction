// Render fixed positions with: neato -n2 -Tpng loading-main-thread-handoff.dot -o loading-main-thread-handoff.png
digraph LoadingMainThreadHandoff {
  graph [layout=neato, overlap=true, splines=polyline, bgcolor="white", pad="0.3", fontname="Microsoft YaHei", fontsize=24, fontcolor="#17324d", labelloc=t, label="启动加载：工作线程交回结果，主线程继续初始化"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=16, fontcolor="#17324d", margin="0.18,0.14", width=4.8, height=1.0, penwidth=1.3];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=13, fontcolor="#415b73", arrowsize=0.8, penwidth=1.4];
  mainlabel [pos="300,2010!", shape=plain, style="", fontsize=21, label="主线程：按帧检查与继续"];
  loaderlabel [pos="920,2010!", shape=plain, style="", fontsize=21, label="长任务线程：加载主体"];
  helperslabel [pos="1500,2010!", shape=plain, style="", fontsize=21, label="参与某个加载阶段的线程"];
  queue [pos="300,1860!", label="Root.Start 依次排入\n① 后台数据加载\n② 主线程界面初始化"];
  select [pos="300,1715!", label="LongEventsUpdate\n从 eventQueue 取出加载任务"];
  launch [pos="300,1570!", label="后续一次更新\n建立并启动 eventThread"];
  load [pos="920,1570!", label="LoadAllPlayData\n开始执行加载主体", fillcolor="#fff3d8", color="#cfb579"];
  read [pos="920,1410!", label="XML 读取阶段\n调用方也参与取文件"];
  readers [pos="1500,1410!", label="新建两个读取线程\n共同从待处理集合取文件\n按下标写回结果数组", fillcolor="#fff3d8", color="#cfb579"];
  join [pos="920,1265!", label="对两个读取线程调用 Join\n等它们结束后，取得本组结果"];
  readersdone [pos="1500,1265!", label="本组文件处理完毕\n两个读取线程结束", fillcolor="#e8f4ed", color="#a5cbb8"];
  check [pos="300,1230!", shape=diamond, style=filled, width=4.0, height=1.4, label="每次更新检查\neventThread.IsAlive\n加载线程仍在运行？", fillcolor="#fff3d8", color="#cfb579"];
  refs [pos="920,1100!", label="引用解析阶段\n切分批次并提交给线程池"];
  pool [pos="1500,1100!", label="线程池执行各批次\n逐项调用 TryResolve", fillcolor="#fff3d8", color="#cfb579"];
  poolwait [pos="920,955!", label="检查完成计数，必要时 WaitOne\n等齐本轮批次后继续处理结果"];
  pooldone [pos="1500,955!", label="每批结束：累计 tasksDone\n再调用 Set 通知调用方", fillcolor="#e8f4ed", color="#a5cbb8"];
  register [pos="920,795!", label="继续后续加载步骤\n通过 ExecuteWhenFinished\n保存结束后要执行的函数"];
  exit [pos="920,630!", label="DoPlayLoad 返回\n设置 loadedInt = true\nLoadAllPlayData 返回，线程结束", fillcolor="#e8f4ed", color="#a5cbb8"];
  finish [pos="300,630!", label="检查到线程结束\n执行 toExecuteWhenFinished\n依次调用已保存的后续函数", fillcolor="#e8f4ed", color="#a5cbb8"];
  next [pos="300,465!", label="清理当前加载任务\n从 eventQueue 取出界面任务"];
  ui [pos="300,300!", label="后续一次 LongEventsUpdate\n同步调用 action\n建立 SoundRoot 与 UIRoot", fillcolor="#e8f4ed", color="#a5cbb8"];
  frame [pos="300,135!", label="界面任务完成\nLongEventsUpdate 返回\n引擎继续本轮后续步骤"];
  render [pos="920,135!", label="主线程采集并交出 RenderFrame\n渲染线程按帧数据队列继续工作", fillcolor="#f0eafa", color="#b5a1d1"];
  queue:s -> select:n;
  select:s -> launch:n;
  launch:e -> load:w [label="Thread.Start"];
  launch:s -> checkentry [arrowhead=none];
  load:s -> read:n;
  read:e -> readers:w [label="分配文件"];
  read:s -> join:n;
  readers:s -> readersdone:n;
  readersdone:w -> join:e [style=dashed, label="Join 返回"];
  join:s -> refs:n [label="继续中间加载步骤"];
  refs:e -> pool:w [label="提交批次"];
  refs:s -> poolwait:n;
  pool:s -> pooldone:n;
  pooldone:w -> poolwait:e [style=dashed, label="累计并通知"];
  poolwait:s -> register:n;
  register:s -> exit:n;
  check:s -> finish:n [label="否"];
  exit:w -> finish:e [style=dashed, label="主线程确认结束"];
  finish:s -> next:n;
  next:s -> ui:n;
  ui:s -> frame:n;
  frame:e -> render:w [label="沿既有帧流程"];
  node [shape=point, width=0.001, height=0.001, label="", style=invis];
  loopbottom [pos="32,1230!"];
  looptop [pos="32,1480!"];
  checkentry [pos="300,1480!", shape=point, width=0.001, height=0.001, label="", style=invis];
  check:w -> loopbottom [arrowhead=none];
  loopbottom -> looptop [arrowhead=none];
  looptop -> checkentry [arrowhead=none];
  checkentry -> check:n;
  looplabel [pos="160,1400!", shape=plain, style="", fontsize=13, fontcolor="#526d85", label="是：返回帧循环\n绘制加载画面，后续帧再查"];
  note [pos="920,-25!", shape=plain, style="", fontsize=14, fontcolor="#526d85", label="普通启动成功路径；省略其他加载步骤与可选场景分支。\n读取线程与线程池参与不同阶段；纵向距离不表示耗时，虚线表示完成等待或结束确认。"];
}
