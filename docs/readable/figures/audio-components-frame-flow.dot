digraph AudioComponentsFrame {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.65", ranksep="0.5", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="一帧中的声源、监听器与后端"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.18,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  begin [label="Bootstrap 登记的 OnUpdate\n调用 UnityRuntime.Step", fillcolor="#f0eafa", color="#b5a1d1"];
  source [label="UnityWorld.Update\n尝试调用活动 AudioSource.Update\n有主播放且 spatialBlend > 0 时更新空间状态"];
  sourceData [label="主播放 IAudioVoice\n接收声源 Transform.position 等参数", fillcolor="#e8f4ed", color="#a5cbb8"];
  rest [label="继续 LateUpdate 等阶段\nUnityRuntime.Step 返回"];
  listener [label="AudioListener.SyncToBackend\nCurrent 存在且后端准备好时设置监听参数"];
  listenerData [label="音频后端 SetListener\n接收监听 Transform 的 position / forward / up", fillcolor="#e8f4ed", color="#a5cbb8"];
  backend [label="当前 AudioBackend 存在时\n调用其 Update\nMiniAudio 已初始化时调用原生 wa_update", fillcolor="#e8f4ed", color="#a5cbb8"];
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="实线：本段主线程调用顺序　　虚线：向后端设置参数\n图示不代表音频设备输出的完整过程。"];
  begin -> source -> rest -> listener -> backend;
  source -> sourceData [style=dashed, color="#3a8b74", label="设置声源参数", constraint=false];
  listener -> listenerData [style=dashed, color="#3a8b74", label="设置监听参数", constraint=false];
  {rank=same; source; sourceData;}
  {rank=same; listener; listenerData;}
  sourceData -> listenerData [style=invis];
  backend -> legend [style=invis];
}
