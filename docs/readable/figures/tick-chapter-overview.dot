digraph TickChapterOverview {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.40", ranksep="0.45", fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="一帧怎样推进游戏模拟"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=16, fontcolor="#17324d", margin="0.22,0.14", penwidth=1.2];
  edge [color="#526d85", arrowsize=0.8, penwidth=1.3];
  frame [label="游玩帧进入 Game.UpdatePlay\n取得本帧的时间间隔"];
  control [label="玩家选择和事件限制\n决定有效速度及暂停状态", fillcolor="#fff3d8", color="#cfb579"];
  balance [label="TickManagerUpdate\n检查暂停，准备时间余额与本帧限制"];
  tick [label="DoSingleTick 可执行零次、一次或多次\n每步更新地图、轮选对象组并推进全局系统\n每步返回后扣除时间并检查能否继续", fillcolor="#e8f4ed", color="#a5cbb8"];
  after [label="返回 Game.UpdatePlay\n继续信件、世界和地图等帧级更新", fillcolor="#f0eafa", color="#b5a1d1"];
  {rank=same; frame; control;}
  frame -> balance;
  control -> balance;
  balance -> tick -> after;
}
