digraph XmlPatchSequence {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.45", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="Sequence：按顺序执行，遇到 false 就结束本组"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  start [label="Sequence 作为顶层操作\n进入 ApplyWorker，遍历 operations"];
  more [shape=diamond, style=filled, label="还有下一项？", fillcolor="#fff3d8", color="#cfb579"];
  call [label="对子操作调用 Apply(xml)\n各操作使用同一份 XML"];
  check [shape=diamond, style=filled, label="返回 true？", fillcolor="#fff3d8", color="#cfb579"];
  success [label="全部正常返回 true\n本组返回 true", fillcolor="#e8f4ed", color="#a5cbb8"];
  failure [label="记录 lastFailedOperation\n本组返回 false\n剩余子操作不再执行", fillcolor="#fbeceb", color="#d4aaa6"];
  start -> more;
  more -> call [label="是"];
  more -> success [label="否"];
  call -> check;
  check -> more [label="是，继续下一项", constraint=false];
  check -> failure [label="否"];
  {rank=same; failure; success;}
  outer [label="回到最外层 ApplyPatches\n不检查这个 bool，继续下一项顶层补丁", fillcolor="#f0eafa", color="#b5a1d1"];
  success -> outer;
  failure -> outer;
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="图中 Sequence 的 success 保持默认 Normal，只画正常返回路径。\n本组失败不撤销已完成的修改；异常按实际调用栈交给外层处理。\n嵌套使用时先返回直接调用者；Apply 可按 success 改变正常返回结果。"];
  outer -> legend [style=invis];
}
