digraph WaylithReleaseHandoff {
  graph [rankdir=TB, newrank=true, bgcolor="white", pad="0.28", nodesep="0.55", ranksep="0.65", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="交接绘制数据：两种等待\n两段分别阅读；位置不表示实际耗时"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.18,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  subgraph cluster_full {
    label="① 队列已满：主线程等待空位"; fontsize=18; color="#d2b66e"; style="rounded"; bgcolor="#fffdf6"; margin=22;
    full_main [label="主线程尝试加入新包\n没有空位，等待", fillcolor="#fff2ce", color="#d2b66e"];
    full_render [label="渲染线程\n取走一个已排队的旧包", fillcolor="#e8f4ed", color="#a5cbb8"];
    full_resume [label="主线程\n新包加入，调用返回"];
    full_continue [label="渲染线程\n继续处理取走的旧包", fillcolor="#e8f4ed", color="#a5cbb8"];
    {rank=same; full_main; full_render;}
    {rank=same; full_resume; full_continue;}
    full_main -> full_resume [label="等待解除"];
    full_render -> full_resume [label="取包腾出空位", style=dashed, color="#3e8f91", fontcolor="#32797b"];
    full_render -> full_continue;
  }
  subgraph cluster_empty {
    label="② 队列为空：渲染线程等待数据"; fontsize=18; color="#d2b66e"; style="rounded"; bgcolor="#fffdf6"; margin=22;
    empty_main [label="主线程\n收集并加入新包"];
    empty_render [label="渲染线程尝试取包\n没有数据，等待", fillcolor="#fff2ce", color="#d2b66e"];
    empty_continue [label="主线程\n入队返回，继续后续工作"];
    empty_resume [label="渲染线程\n取得并处理新包", fillcolor="#e8f4ed", color="#a5cbb8"];
    {rank=same; empty_main; empty_render;}
    {rank=same; empty_continue; empty_resume;}
    empty_main -> empty_continue;
    empty_main -> empty_resume [label="新数据可用", style=dashed, color="#3e8f91", fontcolor="#32797b"];
    empty_render -> empty_resume [label="等待解除"];
  }
  full_resume -> empty_main [style=invis, minlen=1];
  full_continue -> empty_render [style=invis, minlen=1];
  legend [shape=plain, fontsize=12, fontcolor="#526d85", label="虚线表示使等待条件满足的动作。\n取包或入队完成后，两端分别继续；GPU 执行和实际显示还在后面。"];
  empty_continue -> legend [style=invis];
  empty_resume -> legend [style=invis];
}
