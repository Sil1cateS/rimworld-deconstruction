digraph WaylithReleaseOverview {
  graph [rankdir=TB, newrank=true, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", splines=polyline, fontname="Microsoft YaHei", fontsize=23, fontcolor="#17324d", labelloc=t, label="Waylith：从启动到画面输出"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=16, fontcolor="#17324d", margin="0.18,0.14", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=13, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  startup [label="创建引擎应用 → 初始化\n接好更新、输入和绘制功能", fillcolor="#f1eafa", color="#b8a3d5"];
  subgraph cluster_main {
    label="主线程"; fontsize=18; color="#aac8e0"; style="rounded"; bgcolor="#f5f9fd"; margin=18;
    input [label="计时、维护资源\n接收窗口输入"];
    update [label="调用更新\n游戏、兼容层、音频等"];
    capture [label="收集绘制数据\n组成 RenderFrame"];
    {rank=same; input; update; capture;}
    input -> update -> capture;
  }
  queue [label="容量有限的绘制数据队列\n满时等待空位，空时等待数据", fillcolor="#fff2ce", color="#d2b66e"];
  subgraph cluster_render {
    label="渲染线程"; fontsize=18; color="#a5cbb8"; style="rounded"; bgcolor="#f4faf6"; margin=18;
    take [label="取出数据包\n取得可用绘制资源", fillcolor="#e8f4ed", color="#a5cbb8"];
    record [label="记录绘制指令\n写入指令缓冲", fillcolor="#e8f4ed", color="#a5cbb8"];
    submit [label="通过 Vulkan 提交\n请求呈现图像", fillcolor="#e8f4ed", color="#a5cbb8"];
    {rank=same; take; record; submit;}
    take -> record -> submit;
  }
  display [label="驱动、GPU 与呈现路径\n执行图形工作，显示画面", fillcolor="#edf0f5", color="#a6b4c7"];
  startup -> update [style=invis, weight=20];
  startup -> input [constraint=false];
  update -> queue [style=invis, weight=20];
  capture -> queue [label="入队", constraint=false];
  queue -> record [style=invis, weight=20];
  queue -> take [label="取包", constraint=false];
  record -> display [style=invis, weight=20];
  submit -> display [constraint=false];
  legend [shape=plain, fontsize=12, fontcolor="#526d85", label="主线程入队返回后可以继续后续工作；渲染线程与 GPU 可同时处理此前的数据。\n图示正常绘制主线，等待、重建与退出等分支在正文另行解释。"];
  display -> legend [style=invis];
}
