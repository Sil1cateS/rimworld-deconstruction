digraph ThingMakerLongswordCreation {
  graph [rankdir=TB, compound=true, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.43", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="MakeThing：一件原版长剑怎样建立"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  start [label="MakeThing(def, stuff)\ndef：长剑定义；stuff：钢的定义"];
  material [label="依次检查材质参数\n必要时选择默认材质或设为 null"];
  create [label="Activator.CreateInstance(def.thingClass)\n本例建立 ThingWithComps"];
  refs [label="thing.def = def\nSetStuffDirect(stuff)：保存材质引用"];
  subgraph cluster_postmake {
    label="thing.PostMake() → ThingWithComps.PostMake";
    fontname="Microsoft YaHei"; fontsize=16; fontcolor="#415b73"; color="#a5cbb8"; style="rounded"; margin=18;
    base [label="base.PostMake() → Thing.PostMake\n分配物品编号，设置初始当前耐久", fillcolor="#e8f4ed", color="#a5cbb8"];
    comps [label="InitializeComps()\n按配置逐项建立实际组件并准备查询表", fillcolor="#e8f4ed", color="#a5cbb8"];
    componentPost [label="逐个调用实际组件的 PostPostMake()\n接收者是 this.comps[i]", fillcolor="#fff3d8", color="#cfb579"];
    base -> comps -> componentPost;
  }
  thingPost [label="thing.PostPostMake()\n本例沿用 Thing 实现，按配置处理随机风格", fillcolor="#f0eafa", color="#b5a1d1"];
  end [label="返回 thing\n本例的品质组件先持有 Normal"];
  start -> material -> create -> refs;
  refs -> base [lhead=cluster_postmake];
  componentPost -> thingPost -> end;
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="图示正常完成路径；材质判断见正文，组件循环另图展开。\n初始耐久设置发生在实际组件建立之前，材质引用已经保存。\n制造品质、地图放置与其他来源处理由后续调用继续。"];
  end -> legend [style=invis];
}
