digraph WaylithRenderConsumer {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.38", ranksep="0.45", splines=polyline, fontname="Microsoft YaHei", fontsize=23, fontcolor="#17324d", labelloc=t, label="渲染线程：数据包怎样进入记录与提交\n正常控制流；异常停止路径另述"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fa", color="#a7bacd", fontname="Microsoft YaHei", fontsize=14, fontcolor="#17324d", margin="0.16,0.12", penwidth=1.2];
  edge [color="#526a81", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.7, penwidth=1.2];
  consume [label="GetConsumingEnumerable 取下一包\n队列为空且仍接收数据时等待"];
  more [shape=diamond, style=filled, fillcolor="#fff2ce", label="取到数据包？"];
  endloop [label="已停止入队且剩余包已取完\n结束处理数据包的循环", fillcolor="#edf0f3"];
  packetrebuild [shape=diamond, style=filled, fillcolor="#fff2ce", label="包内直接请求重建？"];
  earlyresize [label="登记重建请求\nretained = false", fillcolor="#f5edfa"];
  acquire [label="选择提交槽位并等待旧 fence\n→ 获取交换链图像"];
  olddispose [label="读取提交槽位编号\n回收该槽位保留的旧包"];
  acquired [shape=diamond, style=filled, fillcolor="#fff2ce", label="获取结果？"];
  acqrebuild [label="登记 Resize / Surface 重建\nretained = false", fillcolor="#f5edfa"];
  skip [label="本次不记录、不提交\nretained = false", fillcolor="#f3f3f3"];
  record [label="帧开始维护与目标通知\nReset / Begin → RecordFrame → End", fillcolor="#e6f3eb"];
  submit [label="TrySubmitFrame\n先图形提交，再发起呈现", fillcolor="#e6f3eb"];
  repair [shape=diamond, style=filled, fillcolor="#fff2ce", label="呈现返回重建状态？"];
  postresize [label="登记后续重建请求\n本次图形提交已经发生", fillcolor="#f5edfa"];
  retain [label="保留 packet 到提交槽位\nretained = true", fillcolor="#e6f3eb"];
  ended [label="外层收尾：FrameEnded 通知"];
  kept [shape=diamond, style=filled, fillcolor="#fff2ce", label="retained？"];
  dispose [label="Dispose 本次数据包", fillcolor="#f3f3f3"];
  complete [label="MarkFrameComplete\npending 减一；归零时设置 idle"];
  future [label="后续再次使用这个槽位\n等提交 fence 后才回收保留包", fillcolor="#f5edfa"];
  consume -> more;
  more -> endloop [label="否"];
  more -> packetrebuild [label="是"];
  packetrebuild -> earlyresize [label="是"];
  packetrebuild -> acquire [label="否"];
  acquire -> olddispose;
  olddispose -> acquired;
  acquired -> record [label="Success"];
  acquired -> acqrebuild [label="NeedsResize / SurfaceLost"];
  acquired -> skip [label="NotReady"];
  record -> submit;
  submit -> repair;
  repair -> postresize [label="是"];
  repair -> retain [label="否"];
  postresize -> retain;
  earlyresize -> ended;
  acqrebuild -> ended;
  skip -> ended;
  retain -> ended;
  ended -> kept;
  kept -> dispose [label="否"];
  kept -> complete [label="是：本次保留"];
  dispose -> complete;
  complete -> consume [label="下一包", constraint=false, color="#7890a5"];
  retain -> future [style=dotted, color="#9672ad", label="生命周期说明", constraint=false];
}
