digraph ThingCompsInitialization {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.43", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="InitializeComps：共享配置怎样建立各自组件"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  start [label="新建物品进入 InitializeComps\nthis.def.comps 是共享的配置列表"];
  any [shape=diamond, style=filled, label="定义中有\n组件配置？", fillcolor="#fff3d8", color="#cfb579"];
  list [label="新建 this.comps 实际组件列表\n从 i = 0 开始遍历配置"];
  more [shape=diamond, style=filled, label="i < def.comps.Count？", fillcolor="#fff3d8", color="#cfb579"];
  attempt [label="尝试建立并初始化第 i 项\n按 compClass 建立 ThingComp\nparent 指向当前物品 → 加入 this.comps\nInitialize 接收对应 CompProperties"];
  result [shape=diamond, style=filled, label="本项 try 中\n是否抛出异常？", fillcolor="#fff3d8", color="#cfb579"];
  error [label="记录错误\n从 this.comps 移除该项", fillcolor="#fbeceb", color="#d4aaa6"];
  increment [label="i++\n继续下一项配置"];
  cache [label="RebuildCompsByType\n缓存常用组件引用", fillcolor="#e8f4ed", color="#a5cbb8"];
  end [label="返回 PostMake\n由 PostMake 继续后续调用"];
  start -> any;
  any -> list [label="是"];
  any -> end [label="否"];
  list -> more;
  more -> attempt [label="是"];
  attempt -> result;
  result -> error [label="是"];
  result -> increment [label="否"];
  error -> increment;
  increment -> more;
  more -> cache [label="否"];
  cache -> end;
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="仅展开单项创建与初始化的 catch，其他异常退出路径未画出。\n组件有各自的 parent 和状态，props 可以指向共同配置。\n配置对象、实际组件与组件查询表分别处在不同层次。"];
  {rank=sink; legend;}
  end -> legend [style=invis];
}
