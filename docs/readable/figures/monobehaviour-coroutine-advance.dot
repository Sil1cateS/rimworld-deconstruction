digraph CoroutineAdvance {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.6", ranksep="0.42", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="Advance：继续执行，直到需要等待或全部结束"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.18,0.12", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  enter [label="Advance(handle, elapsed)", fillcolor="#f0eafa", color="#b5a1d1"];
  stack [shape=diamond, style=filled, label="① Stack 还有迭代器？", fillcolor="#fff3d8", color="#cfb579"];
  move [label="取得栈顶 IEnumerator\n调用 MoveNext"];
  more [shape=diamond, style=filled, label="MoveNext 返回 true？", fillcolor="#fff3d8", color="#cfb579"];
  pop [label="弹出已结束的迭代器\n继续循环，回到①"];
  current [shape=diamond, style=filled, label="读取 Current\n进入对应类型分支", fillcolor="#fff3d8", color="#cfb579"];
  push [label="返回嵌套 IEnumerator\n压入 Stack，回到①\n先推进子过程"];
  completedChild [label="返回已完成或没有 Handle 的 Coroutine\n回到①，继续推进当前迭代器"];
  suspend [label="其他等待分支\n保存 SuspendKind 与所需状态\n本次 Advance 返回", fillcolor="#e8f4ed", color="#a5cbb8"];
  done [label="IsDone = true\n返回", fillcolor="#e8f4ed", color="#a5cbb8"];
  failed [label="MoveNext 抛出异常\n写入错误输出，IsDone = true，返回", fillcolor="#f5e9e9", color="#cba5a5"];
  enter -> stack;
  stack -> done [label="否"];
  stack -> move [label="是"];
  move -> more;
  move -> failed [style=dashed, label="异常"];
  more -> pop [label="否"];
  more -> current [label="是"];
  current -> push [label="嵌套迭代器"];
  current -> completedChild [label="已结束的协程"];
  current -> suspend [label="null、等待标记\n或异步操作等"];
  note [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="① 是同一次 Advance 内的 while 循环检查点。\n标注“回到①”的分支当场继续循环；只有等待分支返回，才交给后续阶段检查。"];
  push -> note [style=invis];
  completedChild -> note [style=invis];
  suspend -> note [style=invis];
  {rank=same; done; stack;}
  {rank=same; move; failed;}
  {rank=same; pop; more;}
  {rank=same; push; completedChild; suspend;}
}
