// Render fixed positions with: neato -n2 -Tpng long-event-async-threads.dot -o long-event-async-threads.png
digraph LongEventAsyncThreads {
  graph [layout=neato, overlap=true, splines=polyline, bgcolor="white", pad="0.28", fontname="Microsoft YaHei", fontsize=21, fontcolor="#17324d", labelloc=t, label="异步长任务：线程执行与主线程收尾"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.18,0.13", width=4.4, height=0.95, penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  main [pos="290,1390!", shape=plain, style="", fontsize=18, label="主线程"];
  task [pos="880,1390!", shape=plain, style="", fontsize=18, label="长任务线程"];
  start [pos="290,1250!", label="处理 currentEvent 的异步分支\neventThread 为空时 new Thread\n调用 Start，本次更新随后返回"];
  worker [pos="880,1250!", label="执行线程入口\nRunEventFromAnotherThread\n调用 eventAction", fillcolor="#fff3d8", color="#cfb579"];
  frames [pos="290,1060!", label="返回外层帧循环\n继续长任务检查与加载界面调用"];
  body [pos="880,1060!", label="执行加载等任务主体\n可修改提示文字、登记后续函数\n异常处理也在本线程中执行", fillcolor="#fff3d8", color="#cfb579"];
  check [pos="290,860!", shape=diamond, style=filled, width=3.8, height=1.3, label="线程已经结束？\n!eventThread.IsAlive", fillcolor="#fff3d8", color="#cfb579"];
  ended [pos="880,860!", label="主体与异常处理结束\n线程入口返回，线程终止", fillcolor="#e8f4ed", color="#a5cbb8"];
  scene [pos="290,655!", label="若有场景名，提交加载请求\n后续更新检查 levelLoadOp.isDone\n完成条件满足后继续"];
  finish [pos="290,450!", label="执行 toExecuteWhenFinished\n再调用非空 callback\n清空 currentEvent、线程与操作引用", fillcolor="#e8f4ed", color="#a5cbb8"];
  next [pos="290,260!", label="返回 LongEventsUpdate\n可出队下一项任务\n后续调用再开始推进它", fillcolor="#f0eafa", color="#b5a1d1"];
  node [shape=point, width=0.001, height=0.001, label="", style=invis];
  loop_bottom [pos="35,860!"];
  loop_top [pos="35,1060!"];
  start:e -> worker:w [label="启动线程"];
  start:s -> frames:n;
  worker:s -> body:n;
  body:s -> ended:n;
  frames:s -> check:n [label="后续更新"];
  check:w -> loop_bottom [label="仍存活", arrowhead=none];
  loop_bottom -> loop_top [arrowhead=none];
  loop_top -> frames:w;
  ended:w -> check:e [style=dashed, label="后续检查观察到结束"];
  check:s -> scene:n [label="已结束"];
  scene:s -> finish:n;
  finish:s -> next:n;
  note [pos="580,80!", shape=plain, style="", fontsize=12, fontcolor="#526d85", label="主线程每次检查后可以返回帧循环；虚线表示读取线程状态，线程结束由后续检查发现。\n可选场景操作由兼容层后续 Step 推进；后续函数与 callback 在本例的主线程收尾阶段调用。"];
}
