digraph CoroutineSchedulerOverview {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.45", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="CoroutineScheduler：登记、检查与继续执行"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.18,0.12", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  start [label="Start(owner, routine)", fillcolor="#f0eafa", color="#b5a1d1"];
  register [label="创建 CoroutineHandle\n设置 Owner，迭代器压入 Stack\n记录加入 _handles"];
  phase [label="UnityWorld 的帧阶段\n或宿主的帧末处理", fillcolor="#f0eafa", color="#b5a1d1"];
  step [label="Step(endOfFrame, elapsed, fixedUpdate)\n将 _handles 的记录引用复制到 _scratch"];
  eligible [shape=diamond, style=filled, label="记录未完成，且本次\n阶段与等待条件满足？", fillcolor="#fff3d8", color="#cfb579"];
  skip [label="本次跳过这条记录\n继续检查副本中的其他记录", fillcolor="#f2f5f8"];
  advance [label="Advance(handle, elapsed)\n调用栈顶迭代器的 MoveNext\n按 Current 决定等待或继续处理栈", fillcolor="#e8f4ed", color="#a5cbb8"];
  done [shape=diamond, style=filled, label="返回后 IsDone\n是否为 true？", fillcolor="#fff3d8", color="#cfb579"];
  waiting [label="已保存新的等待类别与条件\n记录保留在 _handles\n等待后续相应 Step 再次检查"];
  cleanup [label="记录已完成或已停止\n本轮或后续 Step 遍历结束后\n从 _handles 移除", fillcolor="#e8f4ed", color="#a5cbb8"];
  note [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="图中按单条记录画出执行结果；Step 会对副本中的记录逐条检查。\nStart 首次直接调用 Advance，后续由 Step 判断是否再次调用。"];
  {rank=same; start; phase;}
  {rank=same; register; step;}
  start -> register;
  register -> advance [label="首次立即执行"];
  phase -> step;
  step -> eligible;
  eligible -> advance [label="是"];
  eligible -> skip [label="否"];
  advance -> done;
  done -> waiting [label="否"];
  done -> cleanup [label="是"];
  {rank=same; advance; skip;}
  {rank=same; waiting; cleanup;}
  waiting -> note [style=invis];
  cleanup -> note [style=invis];
}
