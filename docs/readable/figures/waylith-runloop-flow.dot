digraph WaylithRunLoop {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.36", ranksep="0.44", splines=polyline, fontname="Microsoft YaHei", fontsize=23, fontcolor="#17324d", labelloc=t, label="RunLoop：一轮循环怎样选择路径\n窗口路径；日志、Profiler 和异常退出细节折叠"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fa", color="#a7bacd", fontname="Microsoft YaHei", fontsize=14, fontcolor="#17324d", margin="0.16,0.12", penwidth=1.2];
  edge [color="#526a81", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.7, penwidth=1.2];
  start [label="建立主线程待执行函数队列\n窗口路径启动渲染线程"];
  closed [shape=diamond, style=filled, fillcolor="#fff2ce", label="Window.ShouldClose？"];
  maintenance [label="排空渲染回调、检查渲染故障\n采样时间、维护资源、轮询输入"];
  focus [shape=diamond, style=filled, fillcolor="#fff2ce", label="失焦且禁止后台运行\n且不是隐藏窗口模式？"];
  focuswait [label="WaitEventsTimeout(0.1)\n本轮不进入 BeginFrame / OnUpdate", fillcolor="#f3f3f3"];
  calculate [label="计算可绘制标记 canRender\n检查最小化、隐藏窗口与平台条件"];
  initialdraw [shape=diamond, style=filled, fillcolor="#fff2ce", label="canRender？"];
  rebuild [shape=diamond, style=filled, fillcolor="#fff2ce", label="需要重建目标\n或 Surface？"];
  zero [shape=diamond, style=filled, fillcolor="#fff2ce", label="表面尺寸为零？"];
  defer [label="重新登记重建请求\n本轮 canRender = false", fillcolor="#f5edfa"];
  rebuildnow [label="WaitUntilIdle → 重建\n通知特性与渲染线程", fillcolor="#f5edfa"];
  update [label="BeginFrame → Pump 取出并调用函数\n→ OnUpdate（游戏更新机会）", fillcolor="#e6f3eb"];
  quitafter [shape=diamond, style=filled, fillcolor="#fff2ce", label="更新后有关闭\n或退出请求？"];
  quitend [label="跳过采集\nfinally 补做 EndFrame", fillcolor="#f3f3f3"];
  finaldraw [shape=diamond, style=filled, fillcolor="#fff2ce", label="本轮 canRender\n仍为 true？"];
  capture [label="BeginMainThreadFrame\n→ CaptureFrame → Enqueue", fillcolor="#e6f3eb"];
  normalend [label="FrameEnqueued → EndFrame\n→ 目标帧率限速", fillcolor="#e6f3eb"];
  nodraw [label="等待渲染线程与设备空闲\n执行无绘制资源维护", fillcolor="#f5edfa"];
  nodrawend [label="目标帧率限速\n→ finally 补做 EndFrame", fillcolor="#f3f3f3"];
  next [label="本轮结束，重新检查循环条件", fillcolor="#edf0f3"];
  shutdown [label="停止渲染线程、排空回调\n进入退出生命周期", fillcolor="#edf0f3"];
  start -> closed;
  closed -> maintenance [label="否"];
  closed -> shutdown [label="是"];
  maintenance -> focus;
  focus -> focuswait [label="是"];
  focus -> calculate [label="否"];
  focuswait -> next;
  calculate -> initialdraw;
  initialdraw -> update [label="否"];
  initialdraw -> rebuild [label="是"];
  rebuild -> update [label="否"];
  rebuild -> zero [label="是"];
  zero -> defer [label="是"];
  zero -> rebuildnow [label="否"];
  defer -> update;
  rebuildnow -> update;
  update -> quitafter;
  quitafter -> quitend [label="是"];
  quitafter -> finaldraw [label="否"];
  quitend -> next;
  finaldraw -> capture [label="是"];
  finaldraw -> nodraw [label="否"];
  capture -> normalend;
  normalend -> next;
  nodraw -> nodrawend;
  nodrawend -> next;
  next -> closed [label="下一轮", constraint=false, color="#7890a5"];
}
