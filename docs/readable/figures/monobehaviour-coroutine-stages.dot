digraph CoroutineStages {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.4", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="协程的帧阶段：正常图形路径，DrivenByHost = true"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.18,0.12", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  early [label="Bootstrap 的 OnUpdate\n先调用 EndOfFrame.Run\n若仍有待处理标记，可在这里继续帧末等待", fillcolor="#f0eafa", color="#b5a1d1"];
  pending [label="UnityRuntime.Step → World.Update\n处理待销毁对象、激活与 Start"];
  pre [label="Updating → StepPreUpdate\n检查 FixedUpdate 类别", fillcolor="#e8f4ed", color="#a5cbb8"];
  update [label="调用活动 Behaviour 的 Update"];
  post [label="PostUpdate → StepPostUpdate\n检查 NextFrame、秒数、协程与异步操作等待", fillcolor="#e8f4ed", color="#a5cbb8"];
  late [label="World.LateUpdate\n调用 LateUpdate 等，再进入 PostLateUpdate"];
  mark [label="PostLateUpdate → StepEndOfFrame\n设置 _endOfFramePending，暂不推进帧末等待", fillcolor="#fff3d8", color="#cfb579"];
  capture [label="Step 返回，继续主线程本帧工作\n采集 RenderFrame，调用 RenderThread.Enqueue"];
  enqueued [label="FrameEnqueued\n→ ScreenCaptureFeature.RunEndOfFrame\n→ EndOfFrame.Run"];
  finish [label="RunPendingEndOfFrame\n存在标记时清除标记，Step(true, ...)\n继续 EndOfFrame 类别", fillcolor="#e8f4ed", color="#a5cbb8"];
  note [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="各阶段只推进符合条件的记录。NextFrame 没有目标帧数检查。\nFrameEnqueued 表示渲染帧入队，图中没有 GPU 完成等待。"];
  early -> pending -> pre -> update -> post -> late -> mark -> capture -> enqueued -> finish;
  finish -> note [style=invis];
}
