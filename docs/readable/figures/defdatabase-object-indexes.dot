digraph DefDatabaseObjectIndexes {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.7", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="三个容器引用同一个定义对象"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=16, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=13, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  database [label="DefDatabase<ThingDef>\n当前类型的静态容器"];
  list [label="defsList\n按顺序保存", fillcolor="#e8f4ed", color="#a5cbb8"];
  names [label="defsByName\n按 defName 查找", fillcolor="#e8f4ed", color="#a5cbb8"];
  hashes [label="defsByShortHash\n按 shortHash 查找", fillcolor="#fff3d8", color="#cfb579"];
  definition [label="一个 ThingDef 实例\ndefName = MeleeWeapon_LongSword", fillcolor="#f0eafa", color="#b5a1d1"];
  {rank=same; list; names; hashes;}
  database -> list;
  database -> names;
  database -> hashes;
  list -> definition [label="列表中的一项"];
  names -> definition [label="名称对应的值"];
  hashes -> definition [style=dashed, label="后续填入"];
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="箭头表示容器持有对象引用，不表示复制对象。\nAdd 写入列表与名称字典；短哈希分配与字典填充另有步骤。"];
  definition -> legend [style=invis];
}
