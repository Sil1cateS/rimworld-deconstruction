digraph XmlUnifiedDocument {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.6", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="统一 XML：复制节点，同时记录来源"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  swordFile [label="MeleeMedieval.xml 的文档\n原长剑节点"];
  baseFile [label="BaseWeapons.xml 的文档\n原父模板节点"];
  swordCopy [label="导入后的长剑节点\n保留自身子节点与 ParentName", fillcolor="#e8f4ed", color="#a5cbb8"];
  baseCopy [label="导入后的父模板节点\n保留自身字段与属性", fillcolor="#e8f4ed", color="#a5cbb8"];
  {rank=same; swordFile; baseFile;}
  subgraph cluster_document {
    label="新的 XmlDocument"; fontname="Microsoft YaHei"; fontsize=16; fontcolor="#526d85"; color="#b5c7d6"; style=rounded;
    root [label="唯一的 Defs 根节点", fillcolor="#f0eafa", color="#b5a1d1"];
    {rank=same; swordCopy; baseCopy;}
    swordCopy -> root [dir=back, label="直接子节点"];
    baseCopy -> root [dir=back, label="直接子节点"];
  }
  swordFile -> swordCopy [label="ImportNode(..., true)\n深复制"];
  baseFile -> baseCopy [label="ImportNode(..., true)\n深复制"];
  map [label="assetlookup 保存来源关系\n导入后的长剑节点 → MeleeMedieval 的 LoadableXmlAsset\n导入后的父模板节点 → BaseWeapons 的 LoadableXmlAsset", fillcolor="#fff3d8", color="#cfb579"];
  root -> map [style=invis];
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="只画两个文件中的部分节点。\n此处没有按 defName 合并字段，也没有执行 ParentName 继承。\nassetlookup 的键是导入后的节点，不是名称字符串。"];
  map -> legend [style=invis];
}
