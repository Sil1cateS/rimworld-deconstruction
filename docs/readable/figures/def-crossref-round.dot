digraph DefCrossRefRound {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.45", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="一轮引用解析：完成的移出，未完成的保留"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  start [label="显式调用 ResolveAllWantedCrossReferences\n读取当前 wantedRefs"];
  attempt [label="并行处理各条记录：TryResolve\n对象与列表可在这里直接写入\n字典在这里准备数据"];
  success [shape=diamond, style=filled, label="这条记录\n正常返回 true？", fillcolor="#fff3d8", color="#cfb579"];
  mark [label="加锁，将记录加入\nresolvedRefs 集合", fillcolor="#e8f4ed", color="#a5cbb8"];
  retain [label="本轮未标记完成\n记录继续留在 wantedRefs\n其中可能已有部分成功写入", fillcolor="#fff3d8", color="#cfb579"];
  wait [label="等待本轮各项并行处理结束"];
  apply [label="调用线程逐个执行已完成记录的 Apply\n对象、列表使用空实现\n字典在这里写入"];
  remove [label="从 wantedRefs 移除已完成记录\n剩余记录等待下次调用或 Clear", fillcolor="#f0eafa", color="#b5a1d1"];
  start -> attempt -> success;
  success -> mark [label="是"];
  success -> retain [label="否"];
  {rank=same; mark; retain;}
  mark -> wait;
  retain -> wait;
  wait -> apply -> remove;
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="图中以一条记录代表并行阶段中的一个处理项，只画正常返回路径。\nTryResolve 的完成条件由各记录类型决定，不等于所有写入都延后到 Apply。\n本方法不撤销列表中本轮已经成功加入的项。"];
  remove -> legend [style=invis];
}
