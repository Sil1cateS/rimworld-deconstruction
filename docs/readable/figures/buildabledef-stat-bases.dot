digraph BuildableDefStatBases {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.65", ranksep="0.65", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="长剑定义中的 statBases 保存了什么"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=16, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=13, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  xml [label="长剑 XML 中的 statBases\nWorkToMake = 18000\nMass = 2", fillcolor="#f2f5f8", color="#aab8c8"];
  definition [label="longSwordDef：一个 ThingDef 实例\n继承 BuildableDef 的 statBases 字段\n以及 Def 的名称等共同数据", fillcolor="#f0eafa", color="#b5a1d1"];
  list [label="statBases\nList<StatModifier>", fillcolor="#e8f4ed", color="#a5cbb8"];
  work [label="一个 StatModifier 对象\nvalue = 18000"];
  mass [label="另一个 StatModifier 对象\nvalue = 2"];
  workDef [label="WorkToMake 的 StatDef\n说明这是哪一种属性", fillcolor="#fff3d8", color="#cfb579"];
  massDef [label="Mass 的 StatDef\n说明这是哪一种属性", fillcolor="#fff3d8", color="#cfb579"];
  xml -> definition [style=dashed, color="#8190a3", fontcolor="#65778d", label="按规则读取并绑定引用\n具体加载流程后文展开"];
  definition -> list [label="字段引用"];
  list -> work [label="列表条目"];
  list -> mass [label="列表条目"];
  {rank=same; work; mass;}
  work -> workDef [label="stat"];
  mass -> massDef [label="stat"];
  {rank=same; workDef; massDef;}
  legend [shape=plain, style="", fontsize=13, fontcolor="#526d85", label="实线表示引用，虚线概括读取；箭头不表示类型继承。\n图中只画长剑节点直接填写的两项，省略父模板与其他内容。"];
  workDef -> legend [style=invis];
  massDef -> legend [style=invis];
}
