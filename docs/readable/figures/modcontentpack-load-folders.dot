digraph ModContentPackLoadFolders {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.55", ranksep="0.5", splines=polyline, fontname="Microsoft YaHei", fontsize=22, fontcolor="#17324d", labelloc=t, label="内容包怎样确定加载目录"];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#a8bfd4", fontname="Microsoft YaHei", fontsize=15, fontcolor="#17324d", margin="0.2,0.15", penwidth=1.2];
  edge [color="#526d85", fontname="Microsoft YaHei", fontsize=12, fontcolor="#415b73", arrowsize=0.75, penwidth=1.3];
  start [label="InitLoadFolders\n建立本包的加载目录列表"];
  configured [shape=diamond, style=filled, label="存在加载目录\n版本配置？", fillcolor="#fff3d8", color="#cfb579"];
  select [label="依次尝试配置列表\n完整当前版本的非空列表\n→ 通过筛选的版本键 → default"];
  found [shape=diamond, style=filled, label="采用了\n配置列表？", fillcolor="#fff3d8", color="#cfb579"];
  explicit [label="从列表末尾向前遍历\n只加入 ShouldLoad 为真的目录\n然后返回", fillcolor="#e8f4ed", color="#a5cbb8"];
  automatic [label="默认规则\n优先选当前主次版本目录\n找不到时，按版本候选选择一个"];
  append [label="存在 Common 时加入 Common\n最后加入内容包根目录", fillcolor="#e8f4ed", color="#a5cbb8"];
  result [label="foldersToLoadDescendingOrder\n优先查找的目录在前面", fillcolor="#f0eafa", color="#b5a1d1"];
  start -> configured;
  configured -> select [label="是"];
  configured -> automatic [label="否"];
  select -> found;
  found -> explicit [label="是"];
  found -> automatic [label="否"];
  automatic -> append;
  explicit -> result;
  append -> result;
  {rank=same; explicit; append;}
  legend [shape=plain, style="", fontsize=12, fontcolor="#526d85", label="配置分支不会自动追加 Common 或根目录。\n采用配置后，即使条件筛选未留下目录，也不会改走默认规则。\n版本键筛选与默认版本候选的具体规则见正文。"];
  result -> legend [style=invis];
}
